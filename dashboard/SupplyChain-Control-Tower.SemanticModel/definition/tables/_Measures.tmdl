	measure 'Exception Count' =
			CALCULATE (
			    DISTINCTCOUNT ( FactOrders[OrderId] ),
			    DimOrderStatus[StatusGroup] = "Exception" || FactOrders[IsLate] = TRUE ()
			)
		formatString: #,0
