		lineageTag: 8120f17e-65a7-4528-8ba8-a07f5924f7aa

	measure 'SLA Breach Count' =
			CALCULATE (
			    DISTINCTCOUNT ( FactShipments[OrderId] ),
			    FactShipments[IsOnTime] = FALSE (),
			    USERELATIONSHIP ( FactShipments[OrderDateKey], DimDate[DateKey] )
			)
		formatString: #,0
		displayFolder: F Risk
		lineageTag: f3707f68-c063-475c-96aa-7a92ceaf9b1e

	measure 'Cost of Returns' = [Return Value] + [Return Orders] * [Cost Per Shipment] * 0.5
		formatString: "$"#,0
		displayFolder: F Risk
		lineageTag: d47f7f82-f6fa-4305-b9be-5e4286bc3140

	measure 'Cost of Stockout' = [Unfilled Demand Value] * ( 1 + [Profit Margin %] )
		formatString: "$"#,0
		displayFolder: F Risk
		lineageTag: 43608ccd-9f12-4756-af85-7d32c80c14c1

	measure 'SC Cost % of Revenue' = DIVIDE ( [Total Supply Chain Cost], [Revenue] )
		formatString: "$"#,0
		displayFolder: F Risk
		lineageTag: ef803d9d-8024-4b5c-b266-beb709c8674a

	measure 'Complete Rate' =
			DIVIDE (
			    CALCULATE (
			        DISTINCTCOUNT ( FactOrders[OrderId] ),
			        DimOrderStatus[StatusCode] IN { "COMPLETE", "CLOSED" }
			    ),
			    [Order Volume]
			)
		formatString: 0.0%
		displayFolder: F Risk
		lineageTag: a46169e3-74eb-487f-92e9-d3c2b89c2eac

	measure 'Customer OTIF' = [OTIF %]
		formatString: 0.0%
		displayFolder: F Risk
		lineageTag: e06639f6-203a-4205-9215-b0450e09213f

	measure 'Procurement Spend' = SUM ( FactProcurement[PoValue] )
		formatString: "$"#,0
		displayFolder: G Procurement
		lineageTag: fb55dd1a-54f1-4830-bbbb-2b95388ed583

	measure 'PO Cycle Time' = AVERAGE ( FactProcurement[SlaDays] )
		formatString: 0.00
		displayFolder: G Procurement
		lineageTag: 90801ffa-5448-498a-987b-0e602b5a3616

	measure 'PO On-Time Receipt %' =
			DIVIDE (
			    CALCULATE ( COUNTROWS ( FactProcurement ), FactProcurement[IsOnTimeReceipt] = TRUE () ),
			    COUNTROWS ( FactProcurement )
			)
		formatString: 0.0%
		displayFolder: G Procurement
		lineageTag: 5edce928-bc7a-4557-b0e1-90c798fb078d

	measure 'PO Ordered Units' = SUM ( FactProcurement[OrderedUnits] )
		formatString: #,0
		displayFolder: G Procurement
		lineageTag: 0a6aded3-23e2-4048-b197-8990073d700f

	measure 'PO Received Units' = SUM ( FactProcurement[ReceivedUnits] )
		formatString: #,0
		displayFolder: G Procurement
		lineageTag: 130a5cb9-5461-4897-a8bf-a3a24be1bc54

	measure 'PO Count' = DISTINCTCOUNT ( FactProcurement[PoNumber] )
		formatString: #,0
		displayFolder: G Procurement
		lineageTag: 50e44d26-c131-4374-91fe-0871efb34416

	measure 'Fill vs Receipt' = [Receipts vs Demand]
		formatString: 0.0%
		displayFolder: G Procurement
		lineageTag: b83d213f-2ec8-4896-ae99-ab611dd06f6d

	measure 'Vendor Snapshot Reliability' = AVERAGE ( FactVendorPerformance[ReliabilityScore] )
		formatString: 0.00
		displayFolder: G Procurement
		lineageTag: 87cfcf53-ba80-4dee-90b9-c5119e6bc1a1

	measure 'Vendor Snapshot Risk' = AVERAGE ( FactVendorPerformance[RiskScore] )
		formatString: 0.00
		displayFolder: G Procurement
		lineageTag: 58ee16a1-cdce-48b0-b8d9-ae40ec451d5d

	measure 'Spend per PO' = DIVIDE ( [Procurement Spend], [PO Count] )
		formatString: "$"#,0
		displayFolder: G Procurement
		lineageTag: 405a8a01-7776-4eca-93c3-b5139eedd3c9

	measure 'CO2 kg' =
			CALCULATE (
			    SUM ( FactShipments[Co2Kg] ),
			    USERELATIONSHIP ( FactShipments[OrderDateKey], DimDate[DateKey] )
			)
		formatString: #,0.0
		displayFolder: H Sustainability
		lineageTag: 874cdd05-a876-479b-b739-85fec703938a

	measure 'CO2 Tonnes' = DIVIDE ( [CO2 kg], 1000 )
		formatString: #,0.0
		displayFolder: H Sustainability
		lineageTag: fe39340f-709d-472b-96f1-d06fa444678f

	measure 'CO2 per Shipment' = DIVIDE ( [CO2 kg], [Shipments Volume] )
		formatString: 0.00
		displayFolder: H Sustainability
		lineageTag: 33977d20-38be-4147-8248-9692d591c23e

	measure 'CO2 Intensity' = DIVIDE ( [CO2 kg], [Revenue] )
		formatString: 0.00
		displayFolder: H Sustainability
		lineageTag: 4393d059-cfff-46f6-a577-e97c37354bc9

	measure 'Air Mode Share' = DIVIDE ( CALCULATE ( [Shipments Volume], DimTransportMode[ModeCode] = "FIR" ), [Shipments Volume] )
		formatString: 0.0%
		displayFolder: H Sustainability
		lineageTag: e2b7a94d-5bd2-413b-bc10-9a79befb4b07

	measure 'Ground Mode Share' =
			DIVIDE (
			    CALCULATE ( [Shipments Volume], DimTransportMode[ModeCode] IN { "STD", "SEC" } ),
			    [Shipments Volume]
			)
		formatString: 0.0%
		displayFolder: H Sustainability
		lineageTag: d3fbcc24-8a6e-4296-b9b3-c4a1660a5f52

	measure 'Sustainability Score' =
			VAR Gnd = [Ground Mode Share] * 100
			VAR Int = MIN ( 100, DIVIDE ( 0.05, [CO2 Intensity] ) * 100 )
			VAR Exp = ( 1 - [Expedite Rate] ) * 100
			RETURN
			    Gnd * 0.50 + Int * 0.30 + Exp * 0.20
		formatString: 0.00
		displayFolder: H Sustainability
		lineageTag: 9d5ec971-91a6-40a7-8a12-e46ff4dd2c06

	measure 'CO2 If Shift First Class 50% to Standard' =
			VAR FirShare = [Air Mode Share]
			VAR Co2Now = [CO2 kg]
			RETURN
			    Co2Now * ( 1 - 0.5 * FirShare * ( 1 - DIVIDE ( 60, 600 ) ) )
		formatString: #,0.0
		displayFolder: H Sustainability
		lineageTag: f4bfbe40-698b-4287-86be-ed7a9d6d2fab

	measure 'Title Selected KPI' =
			VAR K = SELECTEDVALUE ( fp_Metric[fp_Metric], "Revenue" )
			VAR P = SELECTEDVALUE ( DimDate[YearMonth], "Selected period" )
			RETURN
			    K & " · " & P
		formatString: @
		displayFolder: I Chrome
		lineageTag: 4f23daac-549b-4e89-a17c-33baeec4f32f

	measure 'Last Refresh Text' = "Refreshed " & FORMAT ( MAX ( LastRefresh[RefreshDatetime] ), "YYYY-MM-DD HH:mm" )
		formatString: @
		displayFolder: I Chrome
		lineageTag: e17f937f-0544-4a11-900d-f6695f0694e3

	measure 'Filter Caption' =
			VAR Mkt = SELECTEDVALUE ( DimRegion[MarketName], "All markets" )
			VAR Seg = SELECTEDVALUE ( DimCustomer[Segment], "All segments" )
			RETURN
			    Mkt & " · " & Seg
		formatString: @
		displayFolder: I Chrome
		lineageTag: 8e0f7803-bb04-47a8-8409-d909e739b83b

	measure 'Page Subtitle Tower' =
			[Filter Caption] & " · OTIF " & FORMAT ( [OTIF %], "0.0%" )
			    & " · Late " & FORMAT ( [Late Delivery Rate], "0.0%" )
		formatString: @
		displayFolder: I Chrome
		lineageTag: 7f1a5714-95b0-4e4f-927c-2b2e23c8cb39

	measure 'KPI Definition Text' =
			VAR K = SELECTEDVALUE ( fp_Metric[fp_Metric], "Revenue" )
			RETURN
			    SWITCH (
			        TRUE (),
			        K = "Revenue", "Net merchandise value of revenue-eligible order lines.",
			        K = "Profit", "Line profit on revenue-eligible lines.",
			        K = "Order Volume", "Distinct customer orders.",
			        K = "Cost to Serve", "Discounts + freight + delay + returns + fraud (modelled freight).",
			        K = "Working Capital", "On-hand + AR proxy − AP proxy (modelled inventory/PO).",
			        K = "Inventory Value", "On-hand × list at last date in filter (modelled snapshot).",
			        K = "OTIF %", "On time (actual ≤ SLA) and in full (not ship-canceled).",
			        K = "Fill Rate", "Units sold / (sold + unfilled + canceled qty).",
			        K = "Perfect Order %", "OTIF and not fraud and COMPLETE/CLOSED.",
			        K = "Stockout Rate", "Product-warehouse-days with reconstructed stockout.",
			        K = "Inventory Turnover", "COGS / average on-hand value.",
			        K = "Inventory Days", "Average inventory / daily COGS.",
			        K = "Backorder Rate", "Backorder units / (on-hand + backorder) at last date.",
			        K = "Lead Time", "Average actual shipping days.",
			        K = "Lead Time Variance", "Sample variance of actual transit days.",
			        K = "Vendor Reliability", "OTIF of orders for the vendor (department proxy).",
			        K = "Vendor SLA %", "On-time % for the vendor's orders.",
			        K = "Vendor Quality Score", "1 − (canceled + fraud orders) / orders.",
			        K = "Vendor Risk Score", "Weighted late + quality gap + LT stdev + cancel.",
			        K = "Transportation Cost", "Modelled tariff freight, not carrier invoice.",
			        K = "Cost Per Shipment", "Freight / shipment count.",
			        K = "Delivery Delay Rate", "Share of shipments with DaysDelay > 0.",
			        K = "Route Performance Score", "60% OTIF + 25% on-time delay inverse + 15% freight efficiency.",
			        K = "Control Tower Health Score", "Weighted OTIF, perfect order, fill, margin, stockout, vendor SLA.",
			        K = "CO2 Tonnes", "Modelled emissions from mode factors × distance bands.",
			        "See KPI catalog."
			    )
		formatString: @
		displayFolder: I Chrome
		lineageTag: 469291b3-4519-4012-9246-ac0a64cd75e6

	column Id
		lineageTag: daf20b40-9028-4e86-9c02-b09fac7a724c
		isNameInferred
		sourceColumn: [Id]

	partition _Measures = calculated
		mode: import
		source = DATATABLE("Id", INTEGER, {{1}})

