		formatString: 0.0%
		displayFolder: E Inventory / Warehouse
		lineageTag: b29eb76a-1d9b-42fa-9d13-1dac44d7e90b

	measure 'Fast Mover %' = DIVIDE ( CALCULATE ( [Inventory Value], DimProduct[AbcClass] = "A" ), [Inventory Value] )
		formatString: 0.0%
		displayFolder: E Inventory / Warehouse
		lineageTag: a44054eb-eb3a-4f40-a552-85f38a539216

	measure 'ABC-A Revenue %' = DIVIDE ( CALCULATE ( [Revenue], DimProduct[AbcClass] = "A" ), [Revenue] )
