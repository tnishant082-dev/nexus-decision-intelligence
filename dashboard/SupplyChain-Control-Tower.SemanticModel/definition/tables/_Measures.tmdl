	measure 'Dead Stock %' =
			VAR Dead =
			    CALCULATE (
			        [Inventory Value],
			        FILTER ( VALUES ( DimProduct[ProductKey] ), CALCULATE ( SUM ( FactInventory[IssuesUnits] ) ) = 0 )
			    )
			RETURN
			    DIVIDE ( Dead, [Inventory Value] )
		formatString: 0.0%
		displayFolder: E Inventory / Warehouse
		lineageTag: 697e34be-7de1-4a80-861f-d1e62b6b1e4b

	measure 'Inventory Quality' = 1 - [Dead Stock %]
		formatString: 0.00
		displayFolder: E Inventory / Warehouse
		lineageTag: bbf02100-5bd4-4c15-97a5-09076c0a780c

	measure 'Capacity Strain Index' =
			VAR Med = MEDIANX ( VALUES ( DimDate[Date] ), CALCULATE ( [Shipments Volume] ) )
			RETURN
			    DIVIDE ( DIVIDE ( [Shipments Volume], DISTINCTCOUNT ( DimDate[Date] ) ), Med )
		formatString: 0.00
