table 'Metric Basis'
	lineageTag: b2e177f8-4f7b-4552-86b4-87f049a7d4bb

	calculationGroup
		precedence: 10

		calculationItem Net = SELECTEDMEASURE()

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem Gross = IF(SELECTEDMEASURENAME() = "Revenue", [Gross Sales], SELECTEDMEASURE())

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

		calculationItem Returns-only = IF(CONTAINSSTRING(SELECTEDMEASURENAME(), "Return") || SELECTEDMEASURENAME() = "Return Value", SELECTEDMEASURE(), [Return Value])

			formatStringDefinition = SELECTEDMEASUREFORMATSTRING()

	column 'Metric Basis'
