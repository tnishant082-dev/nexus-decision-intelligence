lled_units":2.0,"unfilled_value":63.98},{"product_name":"Titleist Pro V1 High Numbers Personalized Gol","category_name":"Electronics","abc_class":"C","stockout_pct":0.05,"coverage_ratio":11.071,"unfilled_units":5.0,"unfilled_value":259.95},{"product_name":"Under Armour Kids' Mercenary Slide","category_name":"Electronics","abc_class":"C","stockout_pct":0.02,"coverage_ratio":9.765,"unfilled_units":3.0,"unfilled_value":83.97},{"product_name":"Bag Boy Beverage Holder","category_name":"Golf Gloves","abc_class":"C","stockout_pct":0.02,"coverage_ratio":14.125,"unfilled_units":1.0,"unfilled_value":24.99},{"product_name":"Under Armour Women's Micro G Skulpt Running S","category_name":"Boxing & MMA","abc_class":"C","stockout_pct":0.02,"coverage_ratio":7.75,"unfilled_units":1.0,"unfilled_value":54.97},{"product_name":"Clicgear Rovic Cooler Bag","category_name":"Golf Gloves","abc_class":"C","stockout_pct":0.02,"coverage_ratio":10.574,"unfilled_units":2.0,"unfilled_value":79.98},{"product_name":"Under Armour Women's Ignite Slide","category_name":"Electronics","abc_class":"C","stockout_pct":0.02,"coverage_ratio":11.766,"unfilled_units":4.0,"unfilled_value":127.96},{"product_name":"Nike Men's Fingertrap Max Training Shoe","category_name":"Soccer","abc_class":"C","stockout_pct":0.0,"coverage_ratio":10.33,"unfilled_units":0.0,"unfilled_value":0.0}],"segments":[{"segment":"Consumer","customers":10695,"avg_ltv":1535.07,"churn_proxy_180d_pct":45.42},{"segment":"Corporate","customers":6239,"avg_ltv":1542.08,"churn_proxy_180d_pct":45.49},{"segment":"Home Office","customers":3718,"avg_ltv":1507.82,"churn_proxy_180d_pct":44.65}],"modes":[{"mode":"First Class","shipments":10079,"freight":288136.8,"late_pct":95.27,"co2_kg":303471.4},{"mode":"Same Day","shipments":3571,"freight":152318.0,"late_pct":46.15,"co2_kg":289.1},{"mode":"Second Class","shipments":12778,"freight":188766.8,"late_pct":76.72,"co2_kg":8624.1},{"mode":"Standard Class","shipments":39324,"freight":381555.45,"late_pct":38.13,"co2_kg":74195.7}],"knowledge":[{"id":"01_otif_policy","title":"OTIF Service Policy (SAMPLE)","path":"docs/knowledge/01_otif_policy.md","body":"# OTIF Service Policy (SAMPLE)\n\n> **Sample policy for NEXUS RAG demos.** Not a live corporate SOP.\n\n## Definition\n**OTIF** = On-Time In-Full. An order is OTIF when every line ships by the promised date and quantities match the ordered amount.\n\n## Targets\n| Segment | OTIF target | Escalation |\n|---|---|---|\n| Enterprise | \u2265 92% | VP Supply Chain within 48h of weekly miss |\n| Mid-market | \u2265 88% | Regional ops manager |\n| SMB | \u2265 85% | Warehouse lead |\n\n## Investigation playbook\n1. Confirm late vs short-ship split (on-time vs in-full).\n2. Check carrier / mode mix for the affected warehouse.\n3. Review inventory stockouts on top SKUs in the window.\n4. If expedite share > 15%, open freight cost review.\n\n## Evidence required\n- SQL OTIF by warehouse/week\n- Top late carriers\n- Stockout SKUs overlapping late orders\n"},{"id":"02_inventory_policy","title":"Inventory & Safety Stock Policy (SAMPLE)","path":"docs/knowledge/02_inventory_policy.md","body":"# Inventory & Safety Stock Policy (SAMPLE)\n\n> **Sample policy for NEXUS RAG demos.** Figures are illustrative thresholds.\n\n## Coverage bands\n- **Green**: 2\u20136 weeks of supply\n- **Yellow**: 6\u201312 weeks (working-capital review)\n- **Red**: > 12 weeks or stockout flag on A-class SKUs\n\n## Reorder rules\n1. A-class SKUs: reorder at ROP; prefer preferred vendors.\n2. B-class: weekly batch; allow 1 missed cycle before escalation.\n3. C-class: monthly; consolidate POs.\n\n## When to escalate\n- Network weeks-of-supply > 20 with OTIF < 50% \u2192 cash vs service tradeoff workshop.\n- Stockout on A-class for > 3 consecutive days \u2192 expedite approved under freight policy.\n"},{"id":"03_vendor_sla","title":"Vendor SLA & Risk Policy (SAMPLE)","path":"docs/knowledge/03_vendor_sla.md","body":"# Vendor SLA & Risk Policy (SAMPLE)\n\n> **Sample policy for NEXUS RAG demos.**\n\n## Preferred vendor mix\nTarget preferred-vendor PO value share \u2265 75%.\n\n## SLA\n- Standard receipt SLA: 4 business days from PO promise date.\n- On-time receipt below 80% for two consecutive months \u2192 performance plan.\n\n## Risk tiers\n| Tier | Action |\n|---|---|\n| Low | Standard monitoring |\n| Medium | Monthly scorecard |\n| High | Dual-source plan + quality holds |\n\n## Quality holds\nFraud / cancel spikes > 2\u00d7 category baseline trigger receiving inspection.\n"},{"id":"04_freight_expedite","title":"Freight & Expedite Policy (SAMPLE)","path":"docs/knowledge/04_freight_expedite.md","body":"# Freight & Expedite Policy (SAMPLE)\n\n> **Sample policy for NEXUS RAG demos.**\n\n## Mode selection\nPrefer ground when SLA allows. Air only when:\n- Customer SLA breach risk within 48h, or\n- A-class stockout with revenue impact > threshold.\n\n## Expedite share\nNetwork expedite share target < 12%. Above 20% for a rolling 4 weeks \u2192 logistics deep-dive.\n\n## CO2\nTrack CO2 kg per shipment. Air share above 20% of shipments requires sustainability note in monthly ops review.\n"},{"id":"05_returns_fraud","title":"Returns & Fraud Exception Policy (SAMPLE)","path":"docs/knowledge/05_returns_fraud.md","body":"# Returns & Fraud Exception Policy (SAMPLE)\n\n> **Sample policy for NEXUS RAG demos.**\n\n## Returns\nReturn rate alerts when category return value > 8% of revenue for the month.\n\n## Fraud / cancel flags\nOrders marked `is_fraud` or high cancel clusters by payment type require case review before refund release.\n\n## Perfect order\nPerfect order = OTIF + no cancel/fraud + complete delivery. Use as executive quality KPI alongside OTIF.\n"}]}